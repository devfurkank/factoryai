# ── Uygulama ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32-chars-min
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factory_ai
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme123

DATABASE_URL=postgresql+asyncpg://admin:changeme123@postgres:5432/factory_ai
DB_ECHO=false   # true → tüm SQL sorguları loglanır (sadece hata ayıklama için)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Kamera Kaynakları ─────────────────────────────────────────────────────────
# Laptop dahili kamera (Faz 0 geliştirme modu)
WEBCAM_DEVICE_INDEX=0
# RTSP kamera eklemek için RTSP_CAM_<N> (N sadece rakam, örn. 01, 02, ...) tanımlayın.
# Uygulama başlangıcında bu değişkenler otomatik olarak kamera kaydı oluşturur.
# Opsiyonel: RTSP_CAM_<N>_NAME (görünen ad), RTSP_CAM_<N>_LOCATION (konum).
# RTSP_CAM_01=rtsp://admin:pass@192.168.1.100:554/stream1
# RTSP_CAM_01_NAME=Giriş Kapısı Kamerası
# RTSP_CAM_01_LOCATION=Ana Giriş

# ── Tespit / YOLOv8 ──────────────────────────────────────────────────────────
# Docker: /app/models | Yerel Windows: backend\models (ters eğik çizgi ile)
MODELS_DIR=/app/models
DETECTION_CONFIDENCE=0.4
DETECTION_BATCH_SIZE=4
YOLO_GENERAL_MODEL=yolov8x.pt
YOLO_POSE_MODEL=yolov8m-pose.pt
YOLO_PPE_MODEL=last_hardhat_200_epochs.pt
YOLO_FIRE_MODEL=fire_detection.pt

# ── Kare (Frame) İşleme ───────────────────────────────────────────────────────
FRAME_SKIP=3          # Her N. kareyi işle  →  ~8fps detection @ 25fps kaynak

# ── Olay Yönetimi (Event Engine) ──────────────────────────────────────────────
EVENT_DEDUP_SECONDS=5   # Aynı olay bu süre içinde tekrar üretilmez (kayan pencere)

# ── Video / Arşiv ─────────────────────────────────────────────────────────────
# Docker: /app/... | Yerel Windows: göreli klasör verin (örn. clips, thumbnails)
# yoksa /app/thumbnails Windows'ta C:\app\thumbnails olarak çözülür.
CLIPS_DIR=/app/clips
THUMBNAILS_DIR=/app/thumbnails
STREAMS_DIR=/app/streams
VIDEO_PRE_BUFFER_SECONDS=10
VIDEO_POST_BUFFER_SECONDS=10
VIDEO_BUFFER_MAX_FPS=15   # Klip ring buffer boyutlandırma üst sınırı
CLIP_JPEG_QUALITY=80      # Buffer'daki frame'lerin JPEG kalitesi
FFMPEG_BINARY=ffmpeg      # PATH'te değilse tam yol (örn. C:\ffmpeg\bin\ffmpeg.exe)

# ── HLS Canlı Yayın (Faz 5 — sadece RTSP kameralar) ──────────────────────────
# Webcam kameralar HLS yerine MJPEG ile izlenir: /api/detection/{id}/stream
HLS_ENABLED=true
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=3
HLS_FPS=15   # Sabit çıkış FPS (bozuk timestamp bildiren IP kameralar için gerekli)

# ── Alarm / Bildirim ─────────────────────────────────────────────────────────
ALARM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM (Gemma) ───────────────────────────────────────────────────────────────
GEMMA_MODEL=google/gemma-2b-it
GEMMA_DEVICE=cpu   # cpu | cuda

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
